<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cho phép thoát sandbox -->
    <key>com.apple.private.security.container-required</key>
    <false/>
    
    <key>com.apple.private.security.no-container</key>
    <true/>
    
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    
    <!-- Quyền MHA-C2 (MobileHouseArrest) - QUAN TRỌNG -->
    <key>com.apple.private.housearrest</key>
    <true/>
    
    <!-- Platform application (cần Enterprise Cert) -->
    <key>platform-application</key>
    <true/>
    
    <!-- Quyền truy cập các app khác -->
    <key>com.apple.springboard.launchapplications</key>
    <true/>
    
    <key>com.apple.springboard.openurls</key>
    <true/>
    
    <!-- Quyền MobileContainerManager -->
    <key>com.apple.private.mobileinstall.allowed SPI</key>
    <array>
        <string>InstallForLaunchServices</string>
        <string>Install</string>
        <string>UninstallForLaunchServices</string>
        <string>Uninstall</string>
        <string>UpdatePlaceholderMetadata</string>
        <string>InstallPlugIn</string>
        <string>UninstallPlugIn</string>
        <string>Lookup</string>
        <string>CopyInstalledAppInfo</string>
    </array>
    
    <!-- Quyền network đầy đủ -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>app-proxy-provider</string>
        <string>content-filter-provider</string>
        <string>packet-tunnel-provider</string>
        <string>dns-proxy</string>
        <string>dns-settings</string>
    </array>
    
    <!-- Quyền file system -->
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    
    <key>com.apple.private.security.storage.AppBundles</key>
    <true/>
    
    <!-- Quyền process -->
    <key>com.apple.private.security.storage-exchange</key>
    <true/>
    
    <key>get-task-allow</key>
    <true/>
    
    <key>task_for_pid-allow</key>
    <true/>
    
    <key>run-unsigned-code</key>
    <true/>
</dict>
</plist>
